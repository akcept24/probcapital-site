# ProbCapital Marketing Site - Environment Variables
# Copy this file to .env.local for local development
# DO NOT COMMIT .env.local to git!

# ============================================
# Twelve Data API Key (for live ticker)
# ============================================
# Same API key as dashboard uses (TWELVE_DATA_API_KEY)
# Use VITE_ prefix for Vite to expose it to client
VITE_TWELVE_DATA_API_KEY=your-twelve-data-api-key-here
